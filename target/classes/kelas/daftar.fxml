<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <top>
        <VBox spacing="15" style="-fx-padding: 15;" styleClass="header">
            <Label styleClass="title" text="Daftar Produk Toko" />
            
            <HBox alignment="CENTER_LEFT" spacing="15">
                <TextField fx:id="cariField" onAction="#cari" prefWidth="300" promptText="Ketik nama produk..." />
                <Button onAction="#cari" styleClass="button-secondary" text="Cari Data" />
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#tambah" styleClass="button-primary" text="+ Tambah Produk" />
                <Button onAction="#detail" styleClass="button-secondary" text="Lihat Detail Produk" />
                <Button onAction="#hapus" styleClass="button-secondary" text="Hapus Produk" />
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox style="-fx-background-color: #FF0000;" styleClass="page">
            <TableView fx:id="tabel" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="kodeCol" prefWidth="100" text="KODE" />
                    <TableColumn fx:id="gambarCol" prefWidth="120" text="GAMBAR" />
                    <TableColumn fx:id="namaCol" prefWidth="250" text="NAMA PRODUK" />
                    <TableColumn fx:id="kategoriCol" prefWidth="180" text="KATEGORI" />
                    <TableColumn fx:id="hargaCol" prefWidth="180" text="HARGA SATUAN" />
                </columns>
            </TableView>
        </VBox>
    </center>
    
    <bottom>
        <HBox style="-fx-padding: 10 30 20 30;" styleClass="page">
            <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
        </HBox>
    </bottom>
</BorderPane>
